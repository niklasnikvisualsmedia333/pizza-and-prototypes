{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://techmeetsproblems.com/schemas/company-contact-payload.json",
  "title": "Tech Meets Problems company contact payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "company",
    "name",
    "email",
    "format",
    "challenge",
    "submissionType",
    "formVersion",
    "language",
    "submittedAt",
    "landingPage",
    "privacyAccepted",
    "privacyAcceptedAt",
    "privacyVersion",
    "privacyText"
  ],
  "properties": {
    "company": { "type": "string", "minLength": 1, "maxLength": 200 },
    "name": { "type": "string", "minLength": 1, "maxLength": 160 },
    "email": { "type": "string", "format": "email", "maxLength": 254 },
    "role": { "type": "string", "maxLength": 160 },
    "format": { "type": "string", "minLength": 1, "maxLength": 200 },
    "challenge": { "type": "string", "minLength": 1, "maxLength": 5000 },
    "phone": { "type": "string", "maxLength": 80 },
    "timeframe": { "type": "string", "maxLength": 200 },
    "submissionType": { "const": "company_interest" },
    "formVersion": { "type": "string", "minLength": 1, "maxLength": 80 },
    "language": { "enum": ["de", "en"] },
    "submittedAt": { "type": "string", "format": "date-time" },
    "landingPage": { "type": "string", "format": "uri", "maxLength": 2048 },
    "referrer": { "type": "string", "maxLength": 2048 },
    "utmSource": { "type": "string", "maxLength": 250 },
    "utmMedium": { "type": "string", "maxLength": 250 },
    "utmCampaign": { "type": "string", "maxLength": 250 },
    "utmContent": { "type": "string", "maxLength": 250 },
    "utmTerm": { "type": "string", "maxLength": 250 },
    "trackingSummary": { "type": "string", "maxLength": 1500 },
    "privacyAccepted": { "const": true },
    "privacyAcceptedAt": { "type": "string", "format": "date-time" },
    "privacyVersion": { "type": "string", "minLength": 1, "maxLength": 80 },
    "privacyText": { "type": "string", "minLength": 1, "maxLength": 2000 }
  }
}
